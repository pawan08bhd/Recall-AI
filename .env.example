# Port for backend Express server (defaults to 5000)
PORT=5000

# MongoDB connection string
# Defaults to local mongodb://127.0.0.1:27017/chat_search
# For cloud, use your MongoDB Atlas URI: mongodb+srv://<user>:<password>@cluster.mongodb.net/chat_search?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/chat_search

# Embedding Model (HuggingFace / Xenova ONNX)
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# Client URL for CORS (optional in production if served together)
CLIENT_URL=http://localhost:5173
